rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userIsActive() {
      return userDocExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('active', true) != false;
    }

    function hasRole(roles) {
      return userIsActive()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isAuthorizedUser() {
      return hasRole(['admin', 'manager', 'accountant', 'co-manager']);
    }

    // User security profiles: users can read only their own profile;
    // only Admin can list or manage other users.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && userId != request.auth.uid;
    }

    // All active authorized roles can create and edit business records.
    // Only Admin can delete records.
    match /shops/{docId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser();
      allow delete: if isAdmin();
    }

    match /payments/{docId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser();
      allow delete: if isAdmin();
    }

    match /contracts/{docId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser();
      allow delete: if isAdmin();
    }

    match /notices/{docId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser();
      allow delete: if isAdmin();
    }

    // settings/main contains opening cash/bank balances used by the business app.
    match /settings/{docId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser();
      allow delete: if isAdmin();
    }

    // Deny every collection not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
